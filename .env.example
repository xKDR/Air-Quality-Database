# Copy to .env. Never commit .env.

# --- R2 (Cloudflare dashboard -> R2 -> Manage API tokens; read-only on the bucket is enough for the server) ---
CLOUDFLARE_S3=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_ID=
CLOUDFLARE_SECRET=
R2_BUCKET=aqi-data

# --- query service (api/) ---
GATEWAY_SECRET=            # same value as the Worker's ORIGIN_SECRET
PARQUET_DIR=/data/parquet  # or s3://aqi-data to read R2 directly

# --- Cloudflare Tunnel token for the cloudflared container ---
TUNNEL_TOKEN=

# --- exporter (maintainers only) ---
POSTGRES_URL=postgresql://user:password@host:5432/db

# --- operator conveniences, not used by any container ---
CLOUDFLARE_API_TOKEN=      # for `wrangler deploy` (Workers, D1, R2 permissions)
AQI_ADMIN_SECRET=          # the Worker's ADMIN_SECRET, for the /admin page and admin API calls
