{
  "name": "aqi-api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker: API keys, self-serve signup, rate limits, R2 bulk files, and proxy to the query API",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply aqi-api-keys --local",
    "migrate:remote": "wrangler d1 migrations apply aqi-api-keys --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
